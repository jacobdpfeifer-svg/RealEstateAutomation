# Copy to secrets.env (gitignored) — API keys only here

# Postgres connection string. Unset = local SQLite file (leads.db), same as before.
# postgresql://<user>@localhost:5432/re_tax_leads
DATABASE_URL=

# Skip trace (wired in counties.toml as batchdata; falls back to stub if unset)
BATCHDATA_API_KEY=

# Optional alternate provider
TRACERFY_API_KEY=

# Saved HTML is the default. Prefer the official civil index subscription.
# Only enable live portal use after confirming the county permits your workflow.
# A CAPTCHA service key does not establish permission to automate the portal.
DALLAS_CLERK_LIVE_ENABLED=0

# Legacy optional reCAPTCHA provider for explicitly permitted live use
ANTICAPTCHA_API_KEY=
# Or paste a one-off solved token for debugging:
# DALLAS_RECAPTCHA_TOKEN=

# Optional: override fixture directory for Dallas clerk HTML dumps
# DALLAS_CLERK_FIXTURE_DIR=

# Optional authenticated Odyssey (captcha disabled when logged in — not yet wired)
# DALLAS_COURTS_USERNAME=
# DALLAS_COURTS_PASSWORD=

# HTTP pacing is per host across this sequential process; GET gets at most 3 tries.
# POST (including paid skip trace) is never automatically replayed by the transport.
LEADS_HTTP_INTERVAL=1
# Optional truthful identification/contact string:
# LEADS_USER_AGENT=re-tax-leads/0.1 (contact: operator@example.com)
LEADS_MAX_ENRICH_ATTEMPTS=3
# Opt in only while diagnosing source changes; raw downloads contain PII.
LEADS_SAVE_RAW=0
