# Copy to secrets.env (gitignored) — API keys only here

# Skip trace (wired in counties.toml as batchdata; falls back to stub if unset)
BATCHDATA_API_KEY=

# Optional alternate provider
TRACERFY_API_KEY=

# Dallas Odyssey Smart Search reCAPTCHA (anonymous portal)
ANTICAPTCHA_API_KEY=
# Or paste a one-off solved token for debugging:
# DALLAS_RECAPTCHA_TOKEN=

# Optional: override fixture directory for Dallas clerk HTML dumps
# DALLAS_CLERK_FIXTURE_DIR=

# Optional authenticated Odyssey (captcha disabled when logged in — not yet wired)
# DALLAS_COURTS_USERNAME=
# DALLAS_COURTS_PASSWORD=
